{
  "name": "mekh---Kenya's Best Car Service Techinicians",
  "npmrc": "",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "build:only": "rmdir /s /q dist 2>nul & vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "sitemap": "node scripts/generate-sitemap.js",
    "clean": "rmdir /s /q dist 2>nul & rmdir /s /q node_modules\\.vite 2>nul",
    "clean:build": "npm run clean & npm run build",
    "analyze": "ANALYZE=true vite build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.100.13",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/uuid": "^10.0.0",
    "browser-image-compression": "^2.0.2",
    "dompurify": "^3.3.1",
    "leaflet": "^1.9.4",
    "quill": "^2.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.11.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.18",
    "fast-check": "^4.5.3",
    "react-snap": "^1.23.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  },
  "reactSnap": {
    "source": "dist",
    "include": ["/", "/delete-account", "/car-mechanics-near-me"],
    "puppeteerArgs": [
      "--no-sandbox"
    ],
    "crawl": true,
    "inlineCss": false
  }
}
